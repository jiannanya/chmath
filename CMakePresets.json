{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    { "name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CHMATH_BUILD_TESTS": "ON", "CHMATH_BUILD_EXAMPLES": "ON" } },
    { "name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/build/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CHMATH_BUILD_BENCHMARKS": "ON" } },
    { "name": "scalar", "inherits": "release", "binaryDir": "${sourceDir}/build/scalar", "cacheVariables": { "CHMATH_ENABLE_SIMD": "OFF" } },
    { "name": "parallel", "inherits": "release", "binaryDir": "${sourceDir}/build/parallel", "cacheVariables": { "CHMATH_ENABLE_PARALLEL": "ON" } },
    { "name": "sanitize", "inherits": "debug", "binaryDir": "${sourceDir}/build/sanitize", "cacheVariables": { "CHMATH_SANITIZERS": "ON" } }
  ],
  "buildPresets": [ { "name": "debug", "configurePreset": "debug" }, { "name": "release", "configurePreset": "release" }, { "name": "scalar", "configurePreset": "scalar" }, { "name": "parallel", "configurePreset": "parallel" }, { "name": "sanitize", "configurePreset": "sanitize" } ],
  "testPresets": [ { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }, { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }, { "name": "scalar", "configurePreset": "scalar", "output": { "outputOnFailure": true } }, { "name": "parallel", "configurePreset": "parallel", "output": { "outputOnFailure": true } }, { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } } ]
}
